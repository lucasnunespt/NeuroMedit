rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada pessoa com login Google (botão já existente)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Avaliações das meditações
    match /ratings/{ratingId} {
      // Qualquer pessoa pode ler (para calcular a média)
      allow read: if true;

      // Qualquer pessoa pode CRIAR, desde que a avaliação seja válida
      allow create: if isValidRating(request.resource.data);

      // Ninguém pode editar nem apagar
      allow update, delete: if false;
    }

    // ---------- Painel do Lucas (sessão presencial) ----------
    // Admin = quem tem um documento em /admins/{uid}.
    // Esse documento só se cria à mão na consola do Firebase:
    // nenhuma pessoa consegue tornar-se admin a partir do site.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // Cada pessoa só consegue perguntar "sou admin?" sobre si própria.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Horários ocupados: um documento por horário. Leitura pública, sem dados pessoais.
    // Id "AAAA-MM-DD_HH" (Lucas) ou "{proId}_AAAA-MM-DD_HH" (outros profissionais): duas pessoas não reservam o mesmo.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'bookingId', 'proId'])
        && request.resource.data.uid == request.auth.uid
        && (!('proId' in request.resource.data) || slotId.matches(request.resource.data.proId + '_.*'));
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn() && 'proId' in resource.data && resource.data.proId == request.auth.uid);
    }

    // Pedidos de sessão: a pessoa vê e cria só os seus; o profissional vê e gere os seus (proId);
    // o Lucas (admin) vê e gere todos. Pedidos sem proId são do Lucas.
    // Igualdade direta (sem "'proId' in data"): é a forma que as consultas "where proId == uid" conseguem provar.
    // Num pedido sem proId a comparação dá erro, que conta como "não", e as outras condições decidem.
    function isProDoPedido(data) {
      return isSignedIn() && data.proId == request.auth.uid;
    }
    function podeApagarPedido(b) {
      return b.estado in ['libertada', 'reembolsada']
        || (b.estado == 'cancelada' && !(b.get('reembolsoPedido', false) == true && b.get('reembolsoFeito', false) != true));
    }
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || isProDoPedido(resource.data)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.estado == 'pedida'
        && !('sinalRecebido' in request.resource.data)
        && request.resource.data.valor is number
        && request.resource.data.sinal is number
        && (!('moradaCliente' in request.resource.data) || (request.resource.data.moradaCliente is string && request.resource.data.moradaCliente.size() <= 200))
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.uid == request.auth.uid
        && (!('proId' in request.resource.data)
            || getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.proId == request.resource.data.proId);
      // A pessoa só pode cancelar o seu pedido; o resto é do profissional ou do Lucas.
      allow update: if isAdmin()
        || (isProDoPedido(resource.data) && request.resource.data.proId == resource.data.proId)
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.estado == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEm', 'reembolsoPedido', 'canceladoPor', 'motivo'])
            && (!('motivo' in request.resource.data) || (request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300)));
      // Apagar histórico: o Lucas apaga o que quiser; o profissional só apaga os seus pedidos já arrumados
      // (libertada, reembolsada, ou cancelada sem reembolso por fazer). Nunca um pedido vivo nem dinheiro por devolver.
      allow delete: if isAdmin()
        || (isProDoPedido(resource.data) && podeApagarPedido(resource.data));
    }

    // Disponibilidade por mês: todos leem meses publicados; só o Lucas escreve.
    match /availability/{monthId} {
      allow read: if isAdmin() || resource.data.publicado == true;
      allow write: if isAdmin();
    }

    // Preços, sinal, regras, locais: leitura pública, escrita só do Lucas.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Contas por profissional (nov 2026) ----------
    // /pros/{proId}: proId = uid da conta Google do profissional. Campos: perfil (público), sessao (preços, locais,
    // semana, contactos), estado: rascunho → pendente → aprovado. Só o Lucas (admin) aprova.
    // 'lixeira' = retirada pelo Lucas (não é pública; só ele a restaura ou apaga para sempre).
    // Público só depois de aprovado; o próprio profissional e o Lucas veem sempre.
    function isDono(proId) {
      return isSignedIn() && request.auth.uid == proId;
    }
    // ---------- Convites (nov 2026): o Lucas reserva uma página para um e-mail ----------
    // /convites/{e-mail em minúsculas}: { email, perfil, criadoEm }. Quem entra com esse e-mail (verificado) reclama a página:
    // cria /pros/{uid} aprovado com este perfil e apaga o convite. Antes disso a página não é pública nem aceita reservas.
    function emailDoLogin() {
      return request.auth.token.email.lower();
    }
    function ehOConvidado(conviteId) {
      return isSignedIn() && request.auth.token.email_verified == true && emailDoLogin() == conviteId;
    }
    function temConvite() {
      return isSignedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/convites/$(emailDoLogin()));
    }
    function conviteDoUtilizador() {
      return get(/databases/$(database)/documents/convites/$(emailDoLogin())).data;
    }
    match /convites/{conviteId} {
      allow read: if isAdmin() || ehOConvidado(conviteId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'perfil', 'criadoEm'])
        && request.resource.data.email is string
        && conviteId == request.resource.data.email.lower()
        && request.resource.data.perfil is map;
      allow delete: if isAdmin() || ehOConvidado(conviteId);
    }

    match /pros/{proId} {
      allow read: if isAdmin() || isDono(proId) || resource.data.estado == 'aprovado';
      // Dois caminhos: rascunho (a pessoa cria a sua página sozinha) ou, se o Lucas a convidou pelo e-mail,
      // a página já aprovada, com o perfil exatamente como o Lucas o escreveu no convite.
      allow create: if isDono(proId)
        && (request.resource.data.estado == 'rascunho'
            || (request.resource.data.estado == 'aprovado'
                && temConvite()
                && request.resource.data.perfil == conviteDoUtilizador().perfil));
      // O profissional edita o seu perfil, mas não se aprova: o estado só pode ficar igual ou ir de rascunho a pendente.
      allow update: if isAdmin()
        || (isDono(proId)
            && resource.data.estado != 'lixeira'
            && (request.resource.data.estado == resource.data.estado
                || (resource.data.estado == 'rascunho' && request.resource.data.estado == 'pendente')));
      allow delete: if isAdmin() || isDono(proId);

      match /availability/{monthId} {
        allow read: if isAdmin() || isDono(proId)
          || (resource.data.publicado == true
              && get(/databases/$(database)/documents/pros/$(proId)).data.estado == 'aprovado');
        allow write: if isAdmin() || isDono(proId);
      }
    }

    // =====================================================================
    // COMUNIDADE (nov 2026) — tudo no plano gratuito, sem Cloud Functions.
    // Quem manda: o Lucas (admin) em tudo; o professor só no que criou;
    // o membro só no que é dele. Entra-se por pedido (o Lucas aprova) ou
    // por convite do Lucas ao e-mail da pessoa.
    //   /comMembros/{uid}                  quem pediu, quem está dentro
    //   /comMembros/{uid}/privado/contacto e-mail (só a pessoa e o Lucas)
    //   /comConvites/{e-mail}              convite do Lucas
    //   /comCirculos/{id}                  círculos por intenção
    //   /comPartilhas/{id}                 partilhas (+ respostas, ressoou, privado/autor)
    //   /comGrupos/{id}/mensagens/{id}     grupos fechados com conversa
    //   /comCanal/{id}                     "Dos professores"
    //   /comEncontros/{id}/lugares/{uid}   encontros ao vivo (link do Google Meet)
    //   /comAvisos/{uid}/itens/{id}        avisos dentro do site (no lugar do e-mail)
    //   /comConversas/{a_b}/mensagens/{id} mensagens diretas entre duas pessoas
    //   /comCidades/{id}                   cidades (Lisboa, Recife…): abertas só com anfitrião
    //   /comPedidosCidade/{cidade_uid}     "quero o NeuroMedit na minha cidade"
    //   /comPedidosAnfitriao/{uid}         "quero ser anfitrião" (só o Lucas lê)
    //   /comMembros/{prof}/seguidores/{uid} quem segue um professor (o número só o professor vê)
    // =====================================================================
    function comMembro(uid) {
      return get(/databases/$(database)/documents/comMembros/$(uid)).data;
    }
    function ehMembro() {
      return isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/comMembros/$(request.auth.uid))
            && comMembro(request.auth.uid).estado == 'aprovado');
    }
    function ehProfessor() {
      return isAdmin()
        || (ehMembro() && comMembro(request.auth.uid).papel == 'professor');
    }
    function textoAte(valor, max) {
      return valor is string && valor.size() > 0 && valor.size() <= max;
    }
    function temConviteCom() {
      return isSignedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/comConvites/$(emailDoLogin()));
    }
    function conviteCom() {
      return get(/databases/$(database)/documents/comConvites/$(emailDoLogin())).data;
    }

    // ---------- Cidades (nov 2026) ----------
    // Os círculos são globais (online); a cidade é a camada presencial: mural, encontros no sítio e
    // subcomunidades dos professores. Só o Lucas cria cidades e escolhe os anfitriões; uma cidade
    // só abre com pelo menos um anfitrião. O anfitrião aprova quem pede para entrar na sua cidade.
    function cidade(cidadeId) {
      return get(/databases/$(database)/documents/comCidades/$(cidadeId)).data;
    }
    function existeCidade(cidadeId) {
      return cidadeId is string && exists(/databases/$(database)/documents/comCidades/$(cidadeId));
    }
    function cidadeAberta(cidadeId) {
      return existeCidade(cidadeId) && cidade(cidadeId).estado == 'aberta';
    }
    function ehAnfitriao(cidadeId) {
      return isSignedIn() && existeCidade(cidadeId) && request.auth.uid in cidade(cidadeId).anfitrioes;
    }
    // Quem pediu para entrar e escolheu a cidade deste anfitrião.
    function pendenteDaMinhaCidade(pessoaUid) {
      let m = comMembro(pessoaUid);
      return m.estado == 'pendente' && ('cidade' in m) && ehAnfitriao(m.cidade);
    }
    function cidadeValida(d) {
      return d.keys().hasOnly(['nome', 'pais', 'regiao', 'estado', 'anfitrioes', 'ordem', 'criadoEm'])
        && textoAte(d.nome, 60)
        && d.estado in ['aberta', 'em-breve']
        && d.anfitrioes is list
        && (d.estado == 'em-breve' || d.anfitrioes.size() > 0);
    }
    // Convidado pelo Lucas para anfitrião desta cidade: ao entrar, junta-se a si próprio à lista e a cidade abre.
    function entraComoAnfitriao(cidadeId) {
      return temConviteCom()
        && conviteCom().get('anfitriao', false) == true
        && conviteCom().get('cidade', '') == cidadeId
        && !(request.auth.uid in resource.data.anfitrioes)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anfitrioes', 'estado'])
        && request.resource.data.anfitrioes == resource.data.anfitrioes.concat([request.auth.uid])
        && request.resource.data.estado == 'aberta';
    }
    // Leitura pública: a Terra da entrada mostra a quem ainda não entrou que cidades já têm comunidade.
    // O documento só tem nome, país, região, estado, ordem e os uid dos anfitriões (sem nomes nem e-mails).
    match /comCidades/{cidadeId} {
      allow read: if true;
      allow create: if isAdmin() && cidadeValida(request.resource.data);
      allow update: if (isAdmin() && cidadeValida(request.resource.data)) || entraComoAnfitriao(cidadeId);
      allow delete: if isAdmin();
    }
    // "Quero o NeuroMedit na minha cidade": um pedido por pessoa e cidade (id = cidade_uid).
    // Só o Lucas vê os pedidos de todos, para saber onde abrir a seguir.
    match /comPedidosCidade/{pedidoId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'cidade', 'nome', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && textoAte(request.resource.data.cidade, 60)
        && pedidoId == request.resource.data.cidade + '_' + request.auth.uid
        && (!('nome' in request.resource.data) || textoAte(request.resource.data.nome, 60))
        && request.resource.data.criadoEm == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // "Quero ser anfitrião": um pedido por pessoa. Só o Lucas lê todos.
    match /comPedidosAnfitriao/{pedidoUid} {
      allow read: if isAdmin() || isDono(pedidoUid);
      allow create, update: if isDono(pedidoUid)
        && request.resource.data.keys().hasOnly(['uid', 'cidade', 'nome', 'sobre', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && textoAte(request.resource.data.cidade, 60)
        && textoAte(request.resource.data.nome, 60)
        && textoAte(request.resource.data.sobre, 600)
        && request.resource.data.criadoEm == request.time;
      allow delete: if isAdmin() || isDono(pedidoUid);
    }

    // Perfil (nov 2026): uma linha sobre a pessoa, até 6 interesses, foto pequena (a do Google ou
    // uma imagem reduzida no navegador) e o @utilizador, que tem de ser seu em comUsuarios.
    function perfilValido(uid) {
      let d = request.resource.data;
      return (!('bio' in d) || textoAte(d.bio, 140))
        && (!('interesses' in d) || (d.interesses is list && d.interesses.size() <= 6))
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 30000))
        && (!('mostrarComunidades' in d) || d.mostrarComunidades is bool)
        && (!('quemEscreve' in d) || d.quemEscreve in ['todos', 'professores', 'ninguem'])
        && (!('usuario' in d) || (d.usuario is string
            && existsAfter(/databases/$(database)/documents/comUsuarios/$(d.usuario))
            && getAfter(/databases/$(database)/documents/comUsuarios/$(d.usuario)).data.uid == uid));
    }

    // Os @utilizadores: um documento por nome, com o uid de quem o tem. Qualquer pessoa com sessão
    // pode ver se um nome está livre. Só se cria o seu, e só se a ficha aponta para ele no mesmo lote;
    // só se apaga o seu quando a ficha já aponta para outro.
    match /comUsuarios/{nome} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && nome.matches('^[a-z0-9._]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'em'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/comMembros/$(request.auth.uid)).data.get('usuario', '') == nome;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && (!existsAfter(/databases/$(database)/documents/comMembros/$(request.auth.uid))
                || getAfter(/databases/$(database)/documents/comMembros/$(request.auth.uid)).data.get('usuario', '') != nome));
    }

    match /comMembros/{uid} {
      // Membros aprovados veem-se uns aos outros (nome e papel, sem e-mail).
      allow read: if isAdmin() || isDono(uid) || (ehMembro() && resource.data.estado == 'aprovado')
        || (resource.data.estado == 'pendente' && ehAnfitriao(resource.data.cidade));
      // A pessoa pede para entrar (pendente); só entra logo aprovada se o Lucas a convidou.
      allow create: if isDono(uid)
        && request.resource.data.keys().hasOnly(['nome', 'foto', 'estado', 'papel', 'motivos', 'aceitouCuidados', 'criadoEm', 'resumo', 'cidade'])
        && textoAte(request.resource.data.nome, 60)
        && (!('cidade' in request.resource.data) || existeCidade(request.resource.data.cidade))
        && request.resource.data.papel == 'membro'
        && request.resource.data.aceitouCuidados == true
        && (request.resource.data.estado == 'pendente'
            || (request.resource.data.estado == 'aprovado' && temConviteCom()));
      // A pessoa muda o seu nome, foto e preferências; nunca o estado nem o papel. O Lucas muda tudo.
      allow update: if isAdmin()
        || (isDono(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'foto', 'motivos', 'resumo', 'vistoEm', 'cidade', 'usuario', 'bio', 'interesses', 'mostrarComunidades', 'quemEscreve'])
            && textoAte(request.resource.data.nome, 60)
            && (!('cidade' in request.resource.data) || existeCidade(request.resource.data.cidade))
            && perfilValido(uid))
        // O anfitrião só aprova quem pediu para entrar na sua cidade (não muda mais nada).
        || (pendenteDaMinhaCidade(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'aprovadoEm'])
            && request.resource.data.estado == 'aprovado');
      allow delete: if isAdmin() || isDono(uid) || pendenteDaMinhaCidade(uid);

      match /privado/{docId} {
        allow read: if isAdmin() || isDono(uid);
        allow write: if isDono(uid);
        allow delete: if isAdmin() || pendenteDaMinhaCidade(uid);
      }

      // Seguir um professor (ou o Lucas). Cada pessoa só cria ou apaga o seu documento;
      // o professor lê a lista para saber quantos o seguem (e para lhes mandar avisos). Ninguém mais vê o número.
      match /seguidores/{seguidorUid} {
        allow read: if isAdmin() || isDono(uid) || isDono(seguidorUid);
        allow create: if ehMembro() && isDono(seguidorUid) && seguidorUid != uid
          && request.resource.data.keys().hasOnly(['em'])
          && (exists(/databases/$(database)/documents/admins/$(uid)) || comMembro(uid).papel == 'professor');
        allow update: if false;
        allow delete: if isAdmin() || isDono(seguidorUid);
      }
    }

    match /comConvites/{conviteId} {
      allow read: if isAdmin() || ehOConvidado(conviteId);
      // Com cidade e anfitriao: true, quem entra com este e-mail fica anfitrião dessa cidade.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'criadoEm', 'cidade', 'anfitriao'])
        && request.resource.data.email is string
        && conviteId == request.resource.data.email.lower()
        && (!('cidade' in request.resource.data) || existeCidade(request.resource.data.cidade))
        && (!('anfitriao' in request.resource.data) || (request.resource.data.anfitriao == true && 'cidade' in request.resource.data));
      allow delete: if isAdmin() || ehOConvidado(conviteId);
    }

    // Círculos: quem pediu para entrar já os pode ver (é a prévia enquanto espera).
    match /comCirculos/{circuloId} {
      allow read: if isSignedIn();
      allow create: if ehProfessor()
        && request.resource.data.criador == request.auth.uid
        && textoAte(request.resource.data.nome, 60);
      allow update: if isAdmin()
        || (ehProfessor() && resource.data.criador == request.auth.uid
            && request.resource.data.criador == resource.data.criador
            && textoAte(request.resource.data.nome, 60));
      allow delete: if isAdmin() || (ehProfessor() && resource.data.criador == request.auth.uid);
    }

    // Partilhas. Com nome: o campo uid diz de quem é. Sem nome: não há uid na partilha;
    // o autor fica em /privado/autor, que só o próprio e o Lucas (moderação) leem.
    function autorDaPartilha(partilhaId) {
      return get(/databases/$(database)/documents/comPartilhas/$(partilhaId)/privado/autor).data.uid;
    }
    function ehAutorDaPartilha(partilhaId, data) {
      return isSignedIn()
        && ((data.anon == false && data.uid == request.auth.uid)
            || (data.anon == true && autorDaPartilha(partilhaId) == request.auth.uid));
    }
    function criouOCirculo(circuloId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/comCirculos/$(circuloId)).data.criador == request.auth.uid;
    }
    function imagemDaPratica(v) {
      return v is string && v.size() <= 200000 && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }
    match /comPartilhas/{partilhaId} {
      allow read: if ehMembro();
      allow create: if ehMembro()
        && request.resource.data.keys().hasOnly(['circulo', 'uid', 'nome', 'foto', 'imagem', 'professor', 'anon', 'pratica', 'texto', 'criadoEm', 'denunciada'])
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 500))
        // Foto da prática: só JPEG já reduzido no aparelho (4:3), guardado no próprio documento (plano gratuito, sem Storage).
        && (!('imagem' in request.resource.data) || imagemDaPratica(request.resource.data.imagem))
        // Etiqueta "Professor": só quem é professor, e nunca numa partilha sem nome.
        && (!('professor' in request.resource.data) || (request.resource.data.professor == true && ehProfessor() && request.resource.data.anon == false))
        && textoAte(request.resource.data.texto, 2000)
        && request.resource.data.circulo is string
        // Num círculo (global) ou no mural de uma cidade aberta.
        && (exists(/databases/$(database)/documents/comCirculos/$(request.resource.data.circulo))
            || cidadeAberta(request.resource.data.circulo))
        && request.resource.data.denunciada == false
        && request.resource.data.criadoEm == request.time
        && ((request.resource.data.anon == false && request.resource.data.uid == request.auth.uid)
            || (request.resource.data.anon == true
                && !('uid' in request.resource.data)
                && !('nome' in request.resource.data)
                && !('foto' in request.resource.data)
                && getAfter(/databases/$(database)/documents/comPartilhas/$(partilhaId)/privado/autor).data.uid == request.auth.uid));
      // O autor só muda o texto. Qualquer membro pode denunciar (e só isso). O Lucas resolve a denúncia.
      allow update: if isAdmin()
        || (ehMembro() && ehAutorDaPartilha(partilhaId, resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editadoEm'])
            && textoAte(request.resource.data.texto, 2000))
        || (ehMembro()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['denunciada'])
            && request.resource.data.denunciada == true);
      allow delete: if isAdmin()
        || ehAutorDaPartilha(partilhaId, resource.data)
        || criouOCirculo(resource.data.circulo)
        || ehAnfitriao(resource.data.circulo);

      match /privado/{docId} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if ehMembro() && docId == 'autor'
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }

      match /respostas/{respostaId} {
        allow read: if ehMembro();
        allow create: if ehMembro()
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'foto', 'professor', 'texto', 'criadoEm'])
          && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 500))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.professor == ehProfessor()
          && textoAte(request.resource.data.texto, 1500)
          && request.resource.data.criadoEm == request.time;
        allow update: if isAdmin()
          || (ehMembro()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['denunciada'])
              && request.resource.data.denunciada == true);
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || ehAutorDaPartilha(partilhaId, get(/databases/$(database)/documents/comPartilhas/$(partilhaId)).data)
          || criouOCirculo(get(/databases/$(database)/documents/comPartilhas/$(partilhaId)).data.circulo)
          || ehAnfitriao(get(/databases/$(database)/documents/comPartilhas/$(partilhaId)).data.circulo);
      }

      // "Isto ressoou em mim": cada pessoa só vê o seu. Não existe contagem.
      match /ressoou/{uid} {
        allow read, delete: if isDono(uid) || isAdmin();
        allow create: if ehMembro() && isDono(uid) && request.resource.data.keys().hasOnly(['em']);
        allow update: if false;
      }
    }

    // Grupos: a conversa só é lida por quem está no grupo (e pelo Lucas, para moderar).
    function grupo(grupoId) {
      return get(/databases/$(database)/documents/comGrupos/$(grupoId)).data;
    }
    function estaNoGrupo(grupoId) {
      return isAdmin() || (ehMembro() && request.auth.uid in grupo(grupoId).membros);
    }
    // Vitrine dos grupos abertos: nome, cidade, quem criou e quantas pessoas — nunca quem são.
    // Muda junto com o grupo (no mesmo lote): o número tem de bater com a lista verdadeira.
    function grupoDepois(grupoId) {
      return getAfter(/databases/$(database)/documents/comGrupos/$(grupoId)).data;
    }
    match /comGruposAbertos/{grupoId} {
      allow read: if isAdmin() || ehMembro();
      allow create, update: if isAdmin()
        || (ehMembro()
            && existsAfter(/databases/$(database)/documents/comGrupos/$(grupoId))
            && grupoDepois(grupoId).tipo == 'aberto'
            && request.resource.data.n == grupoDepois(grupoId).membros.size()
            && (
              // Quem criou o grupo escreve a vitrine (nome, cidade, número).
              (grupoDepois(grupoId).criador == request.auth.uid
                && request.resource.data.criador == request.auth.uid
                && request.resource.data.keys().hasOnly(['nome', 'criador', 'n', 'criadoEm', 'cidade'])
                && textoAte(request.resource.data.nome, 60))
              // Quem entra ou sai só muda o número.
              || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n']))
            ));
      allow delete: if isAdmin() || (ehMembro() && resource.data.criador == request.auth.uid);
    }

    match /comGrupos/{grupoId} {
      // Privacidade (nov 2026): a lista de quem está num grupo só a veem os que estão nele.
      // Os grupos abertos descobrem-se pela vitrine (comGruposAbertos), sem nomes.
      allow read: if isAdmin()
        || (ehMembro() && request.auth.uid in resource.data.membros);
      allow create: if (ehProfessor() || anfitriaoNoPedido(request.resource.data))
        && request.resource.data.criador == request.auth.uid
        && request.resource.data.tipo in ['privado', 'aberto']
        && request.resource.data.membros is list
        && request.auth.uid in request.resource.data.membros
        && request.resource.data.membros.size() <= 200
        && textoAte(request.resource.data.nome, 60)
        // Subcomunidade de uma cidade aberta (opcional).
        && (!('cidade' in request.resource.data) || cidadeAberta(request.resource.data.cidade));
      // Quem criou gere o grupo; num grupo aberto, cada membro entra ou sai por si (e só mexe em si próprio).
      allow update: if isAdmin()
        || (ehMembro() && resource.data.criador == request.auth.uid
            && request.resource.data.criador == resource.data.criador
            && request.resource.data.membros.size() <= 200)
        || (ehMembro()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
            && ((resource.data.tipo == 'aberto'
                 && request.resource.data.membros.toSet().difference(resource.data.membros.toSet()) == [request.auth.uid].toSet()
                 && request.resource.data.membros.size() == resource.data.membros.size() + 1
                 && request.resource.data.membros.size() <= 200)
                || (resource.data.membros.toSet().difference(request.resource.data.membros.toSet()) == [request.auth.uid].toSet()
                    && request.resource.data.membros.size() == resource.data.membros.size() - 1)));
      allow delete: if isAdmin() || (ehMembro() && resource.data.criador == request.auth.uid);

      match /mensagens/{mensagemId} {
        allow read: if estaNoGrupo(grupoId);
        allow create: if estaNoGrupo(grupoId)
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'criadoEm'])
          && request.resource.data.uid == request.auth.uid
          && textoAte(request.resource.data.texto, 1000)
          && request.resource.data.criadoEm == request.time;
        allow update: if false;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || (isSignedIn() && grupo(grupoId).criador == request.auth.uid);
      }
    }

    // ---------------------------------------------------------------------
    // Mensagens diretas: uma conversa por par (id "uidA_uidB", ordem alfabética).
    // Começa como pedido (só quem pediu escreve); a outra pessoa aceita ou bloqueia.
    // Respeita "quem me pode escrever" (comMembros.quemEscreve). O Lucas só lê
    // as mensagens de uma conversa que alguém denunciou.
    // ---------------------------------------------------------------------
    function conversa(id) {
      return get(/databases/$(database)/documents/comConversas/$(id)).data;
    }
    function naConversa(id) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/comConversas/$(id))
        && request.auth.uid in conversa(id).membros;
    }
    function aceitaDeMim(outro) {
      return exists(/databases/$(database)/documents/comMembros/$(outro))
        && comMembro(outro).estado == 'aprovado'
        && (!('quemEscreve' in comMembro(outro))
            || comMembro(outro).quemEscreve == 'todos'
            || (comMembro(outro).quemEscreve == 'professores' && ehProfessor()));
    }
    match /comConversas/{conversaId} {
      allow read: if (isSignedIn() && request.auth.uid in resource.data.membros)
        || (isAdmin() && resource.data.get('denunciada', false) == true);
      allow create: if ehMembro()
        && request.resource.data.keys().hasOnly(['membros', 'de', 'para', 'estado', 'criadoEm', 'ultimaEm'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para != request.auth.uid
        && request.resource.data.estado == 'pedido'
        && request.resource.data.membros.size() == 2
        && request.auth.uid in request.resource.data.membros
        && request.resource.data.para in request.resource.data.membros
        && conversaId == (request.auth.uid < request.resource.data.para
              ? request.auth.uid + '_' + request.resource.data.para
              : request.resource.data.para + '_' + request.auth.uid)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.ultimaEm == request.time
        && aceitaDeMim(request.resource.data.para);
      allow update: if isSignedIn() && request.auth.uid in resource.data.membros
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'bloqueadaPor', 'ultimaEm', 'ultimaTexto', 'ultimaPor', 'novaPara', 'denunciada'])
        && request.resource.data.membros == resource.data.membros
        && (!('ultimaTexto' in request.resource.data) || request.resource.data.ultimaTexto is string && request.resource.data.ultimaTexto.size() <= 120)
        && (!('ultimaPor' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.ultimaPor == request.auth.uid)
        && (!('denunciada' in request.resource.data) || request.resource.data.denunciada is bool)
        && (
          // Sem mudar o estado: só o resumo da última mensagem (fora de bloqueio) ou marcar como lida.
          (request.resource.data.estado == resource.data.estado
            && !('bloqueadaPor' in request.resource.data.diff(resource.data).affectedKeys())
            && (resource.data.estado != 'bloqueada'
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['novaPara', 'denunciada'])))
          // Aceitar o pedido: só quem o recebeu.
          || (resource.data.estado == 'pedido' && request.resource.data.estado == 'aberta'
              && resource.data.para == request.auth.uid)
          // Bloquear: qualquer um dos dois.
          || (resource.data.estado != 'bloqueada'
              && request.resource.data.estado == 'bloqueada' && request.resource.data.bloqueadaPor == request.auth.uid)
          // Desbloquear: só quem bloqueou.
          || (resource.data.estado == 'bloqueada' && request.resource.data.estado == 'aberta'
              && resource.data.bloqueadaPor == request.auth.uid)
        );
      allow delete: if isAdmin();

      match /mensagens/{mensagemId} {
        allow read: if naConversa(conversaId)
          || (isAdmin() && conversa(conversaId).get('denunciada', false) == true);
        allow create: if naConversa(conversaId)
          && request.resource.data.keys().hasOnly(['uid', 'texto', 'criadoEm'])
          && request.resource.data.uid == request.auth.uid
          && textoAte(request.resource.data.texto, 1000)
          && request.resource.data.criadoEm == request.time
          && (conversa(conversaId).estado == 'aberta'
              || (conversa(conversaId).estado == 'pedido' && conversa(conversaId).de == request.auth.uid));
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Espaço de apoio: um parceiro de cada vez, só o Lucas escreve; os membros leem.
    match /comApoio/{id} {
      allow read: if ehMembro();
      allow create, update: if isAdmin() && id == 'atual'
        && request.resource.data.keys().hasOnly(['quem', 'titulo', 'texto', 'link', 'ativo', 'em'])
        && textoAte(request.resource.data.quem, 60)
        && textoAte(request.resource.data.titulo, 80)
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 200
        && request.resource.data.link is string && request.resource.data.link.matches('https://.{3,300}')
        && request.resource.data.ativo is bool;
      allow delete: if isAdmin();
    }

    // "Dos professores": só professores publicam; todos os membros leem.
    match /comCanal/{avisoId} {
      allow read: if ehMembro();
      allow create: if ehProfessor()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'titulo', 'texto', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && textoAte(request.resource.data.titulo, 120)
        && request.resource.data.criadoEm == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Encontros ao vivo: por agora um link do Google Meet criado pelo professor.
    // Quem cuida de uma cidade (anfitrião) também marca encontros nessa cidade, mesmo sem ser professor.
    function anfitriaoNoPedido(d) {
      return ehMembro() && ('cidade' in d) && ehAnfitriao(d.cidade);
    }
    match /comEncontros/{encontroId} {
      allow read: if ehMembro();
      allow create: if (ehProfessor() || anfitriaoNoPedido(request.resource.data))
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'titulo', 'quando', 'link', 'lugar', 'cidade', 'repete', 'vao', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && textoAte(request.resource.data.titulo, 120)
        && request.resource.data.quando is timestamp
        // Encontro fixo: repete todas as semanas (como as sanghas).
        && (!('repete' in request.resource.data) || request.resource.data.repete == 'semanal')
        && (!('vao' in request.resource.data) || request.resource.data.vao == 0)
        && (!('cidade' in request.resource.data) || cidadeAberta(request.resource.data.cidade))
        // Online: um link do Google Meet. Presencial: um lugar, sempre numa cidade.
        && ((!('lugar' in request.resource.data)
             && request.resource.data.link is string
             && request.resource.data.link.matches('https://meet\\.google\\.com/[a-zA-Z0-9?=&_/-]+'))
            || (!('link' in request.resource.data)
                && 'cidade' in request.resource.data
                && textoAte(request.resource.data.lugar, 160)));
      // "N pessoas vão": o contador só sobe 1 com o lugar guardado nesse momento, e só desce 1 com ele apagado.
      // Assim mostra-se quantos vão sem mostrar quem.
      allow update: if ehMembro()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vao'])
        && ((request.resource.data.vao == resource.data.get('vao', 0) + 1
             && !exists(/databases/$(database)/documents/comEncontros/$(encontroId)/lugares/$(request.auth.uid))
             && existsAfter(/databases/$(database)/documents/comEncontros/$(encontroId)/lugares/$(request.auth.uid)))
            || (request.resource.data.vao == resource.data.get('vao', 0) - 1
                && request.resource.data.vao >= 0
                && exists(/databases/$(database)/documents/comEncontros/$(encontroId)/lugares/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/comEncontros/$(encontroId)/lugares/$(request.auth.uid))));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      match /lugares/{uid} {
        allow read: if isDono(uid) || isAdmin();
        allow create: if ehMembro() && isDono(uid) && request.resource.data.keys().hasOnly(['em']);
        allow update: if false;
        allow delete: if isDono(uid) || isAdmin();
      }
    }

    // Avisos dentro do site (no lugar do e-mail). Só o dono lê e apaga.
    // Um membro pode deixar um aviso curto a outro (ex.: "responderam à sua partilha"), sempre assinado com o seu uid.
    match /comAvisos/{uid}/itens/{avisoId} {
      allow read, delete: if isDono(uid);
      allow create: if (ehMembro() || isAdmin())
        && request.resource.data.keys().hasOnly(['tipo', 'texto', 'link', 'de', 'criadoEm', 'lido'])
        && request.resource.data.tipo in ['aprovado', 'resposta', 'grupo', 'papel', 'boas-vindas', 'seguindo', 'mensagem']
        && request.resource.data.de == request.auth.uid
        && textoAte(request.resource.data.texto, 200)
        && request.resource.data.link is string && request.resource.data.link.size() <= 200
        && request.resource.data.lido == false
        && request.resource.data.criadoEm == request.time;
      allow update: if isDono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lido']);
    }

    function isValidRating(data) {
      return data.keys().hasAll(['meditationId', 'stars', 'createdAt'])
        && data.keys().hasOnly(['meditationId', 'stars', 'comment', 'createdAt'])
        && data.meditationId is string
        && data.meditationId.size() > 0
        && data.meditationId.size() <= 80
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 5
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 500))
        // createdAt tem de ser o relógio do servidor (serverTimestamp)
        && data.createdAt == request.time;
    }
  }
}
