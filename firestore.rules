rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada pessoa com login Google (botão já existente)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Avaliações das meditações
    match /ratings/{ratingId} {
      // Qualquer pessoa pode ler (para calcular a média)
      allow read: if true;

      // Qualquer pessoa pode CRIAR, desde que a avaliação seja válida
      allow create: if isValidRating(request.resource.data);

      // Ninguém pode editar nem apagar
      allow update, delete: if false;
    }

    // ---------- Painel do Lucas (sessão presencial) ----------
    // Admin = quem tem um documento em /admins/{uid}.
    // Esse documento só se cria à mão na consola do Firebase:
    // nenhuma pessoa consegue tornar-se admin a partir do site.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // Cada pessoa só consegue perguntar "sou admin?" sobre si própria.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Horários ocupados: um documento por horário. Leitura pública, sem dados pessoais.
    // Id "AAAA-MM-DD_HH" (Lucas) ou "{proId}_AAAA-MM-DD_HH" (outros profissionais): duas pessoas não reservam o mesmo.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'bookingId', 'proId'])
        && request.resource.data.uid == request.auth.uid
        && (!('proId' in request.resource.data) || slotId.matches(request.resource.data.proId + '_.*'));
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn() && 'proId' in resource.data && resource.data.proId == request.auth.uid);
    }

    // Pedidos de sessão: a pessoa vê e cria só os seus; o profissional vê e gere os seus (proId);
    // o Lucas (admin) vê e gere todos. Pedidos sem proId são do Lucas.
    // Igualdade direta (sem "'proId' in data"): é a forma que as consultas "where proId == uid" conseguem provar.
    // Num pedido sem proId a comparação dá erro, que conta como "não", e as outras condições decidem.
    function isProDoPedido(data) {
      return isSignedIn() && data.proId == request.auth.uid;
    }
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || isProDoPedido(resource.data)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.estado == 'pedida'
        && !('sinalRecebido' in request.resource.data)
        && request.resource.data.valor is number
        && request.resource.data.sinal is number
        && (!('moradaCliente' in request.resource.data) || (request.resource.data.moradaCliente is string && request.resource.data.moradaCliente.size() <= 200))
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.uid == request.auth.uid
        && (!('proId' in request.resource.data)
            || getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.proId == request.resource.data.proId);
      // A pessoa só pode cancelar o seu pedido; o resto é do profissional ou do Lucas.
      allow update: if isAdmin()
        || (isProDoPedido(resource.data) && request.resource.data.proId == resource.data.proId)
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.estado == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEm', 'reembolsoPedido', 'canceladoPor', 'motivo'])
            && (!('motivo' in request.resource.data) || (request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300)));
      allow delete: if isAdmin();
    }

    // Disponibilidade por mês: todos leem meses publicados; só o Lucas escreve.
    match /availability/{monthId} {
      allow read: if isAdmin() || resource.data.publicado == true;
      allow write: if isAdmin();
    }

    // Preços, sinal, regras, locais: leitura pública, escrita só do Lucas.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Contas por profissional (nov 2026) ----------
    // /pros/{proId}: proId = uid da conta Google do profissional. Campos: perfil (público), sessao (preços, locais,
    // semana, contactos), estado: rascunho → pendente → aprovado. Só o Lucas (admin) aprova.
    // Público só depois de aprovado; o próprio profissional e o Lucas veem sempre.
    function isDono(proId) {
      return isSignedIn() && request.auth.uid == proId;
    }
    match /pros/{proId} {
      allow read: if isAdmin() || isDono(proId) || resource.data.estado == 'aprovado';
      allow create: if isDono(proId) && request.resource.data.estado == 'rascunho';
      // O profissional edita o seu perfil, mas não se aprova: o estado só pode ficar igual ou ir de rascunho a pendente.
      allow update: if isAdmin()
        || (isDono(proId)
            && (request.resource.data.estado == resource.data.estado
                || (resource.data.estado == 'rascunho' && request.resource.data.estado == 'pendente')));
      allow delete: if isAdmin() || isDono(proId);

      match /availability/{monthId} {
        allow read: if isAdmin() || isDono(proId)
          || (resource.data.publicado == true
              && get(/databases/$(database)/documents/pros/$(proId)).data.estado == 'aprovado');
        allow write: if isAdmin() || isDono(proId);
      }
    }

    function isValidRating(data) {
      return data.keys().hasAll(['meditationId', 'stars', 'createdAt'])
        && data.keys().hasOnly(['meditationId', 'stars', 'comment', 'createdAt'])
        && data.meditationId is string
        && data.meditationId.size() > 0
        && data.meditationId.size() <= 80
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 5
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 500))
        // createdAt tem de ser o relógio do servidor (serverTimestamp)
        && data.createdAt == request.time;
    }
  }
}
